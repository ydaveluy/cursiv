# Local build trees and CTest output. Keep the general build rule anchored:
# source directories below the root may also start with "build".
/b-*/
/b/
b-mcdc/
/build*/
/Testing/
build-wasi*/
compile_commands.json

# Generated parsers can live below any language's source or build directory.
generated/

# Local editor and Python caches.
.cache/
.claude/
__pycache__/

# Packaging and documentation output.
/dist/
/dist-vsix/
/site/

# VS Code client dependencies and generated files. Keep package-lock.json
# tracked so npm ci can reproduce the dependency installation.
node_modules/
examples/*/vscode/out/
examples/*/vscode/server/
examples/*/vscode/*.vsix
