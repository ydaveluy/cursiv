cmake_minimum_required(VERSION 3.30)
file(MAKE_DIRECTORY "${WORK}")
# Quotes, commas and backslashes must round-trip in JSON and CSV.
set(_input "${WORK}/a,\"b\\c.tiny")
file(WRITE "${_input}" "1 + 2 + 39")
set(_other "${WORK}/other.tiny")
file(WRITE "${_other}" "4 + 5")

function(run_bench executable)
  execute_process(COMMAND "${executable}" ${ARGN}
      RESULT_VARIABLE _rc OUTPUT_VARIABLE _out ERROR_VARIABLE _err)
  if(NOT _rc EQUAL 0)
    message(FATAL_ERROR "benchmark failed (${_rc}): ${ARGN}\n${_out}\n${_err}")
  endif()
  set(BENCH_OUTPUT "${_out}" PARENT_SCOPE)
endfunction()

function(refuse_bench)
  execute_process(COMMAND "${BENCH}" ${ARGN}
      RESULT_VARIABLE _rc OUTPUT_VARIABLE _out ERROR_VARIABLE _err)
  if(_rc EQUAL 0)
    message(FATAL_ERROR "benchmark accepted invalid arguments: ${ARGN}")
  endif()
endfunction()

run_bench("${BENCH}" --help)
run_bench("${BENCH}" --list)
run_bench("${BENCH}" "${_input}" --file "${_other}" --iterations 1
    --json "${WORK}/files.json" --csv "${WORK}/files.csv")
file(READ "${WORK}/files.json" _json)
string(JSON _count LENGTH "${_json}" rows)
string(JSON _source GET "${_json}" rows 0 source)
string(JSON _bytes GET "${_json}" rows 0 bytes)
string(JSON _iterations GET "${_json}" rows 0 iterations)
string(JSON _stageCount LENGTH "${_json}" rows 0 stages)
string(JSON _build GET "${_json}" rows 0 stages build)
if(NOT _count EQUAL 2 OR NOT _source STREQUAL "disk:${_input}" OR
   NOT _bytes EQUAL 10 OR NOT _iterations EQUAL 1 OR
   NOT _stageCount EQUAL 5 OR _build LESS 0)
  message(FATAL_ERROR "file benchmark did not measure the supplied inputs: ${_json}")
endif()

run_bench("${SERVICES_BENCH}" "${_input}" --iterations 1
    --json "${WORK}/lsp.json" --csv "${WORK}/lsp.csv")
if(BENCH_OUTPUT MATCHES "n/a" OR BENCH_OUTPUT MATCHES "\n +complete +")
  message(FATAL_ERROR "console includes absent services or duplicate completion timings")
endif()
file(READ "${WORK}/lsp.json" _lsp)
foreach(_service documentSymbol formatting rangeFormatting completion hover
                 semanticTokens/full foldingRange inlayHint)
  string(JSON _available GET "${_lsp}" rows 0 lsp "${_service}" available)
  string(JSON _ms GET "${_lsp}" rows 0 lsp "${_service}" ms)
  string(JSON _min GET "${_lsp}" rows 0 lsp "${_service}" min_ms)
  string(JSON _max GET "${_lsp}" rows 0 lsp "${_service}" worst_ms)
  string(JSON _samples GET "${_lsp}" rows 0 lsp "${_service}" samples)
  string(JSON _probes GET "${_lsp}" rows 0 lsp "${_service}" probes)
  if(NOT _available OR _min LESS 0 OR _ms LESS _min OR _max LESS _ms OR
     NOT _samples EQUAL _probes)
    message(FATAL_ERROR "installed LSP service was not measured: ${_service}")
  endif()
  if(_samples EQUAL 1 AND (NOT _min EQUAL _ms OR NOT _max EQUAL _ms))
    message(FATAL_ERROR "single-call statistics differ: ${_service}")
  endif()
endforeach()
foreach(_service declaration implementation typeDefinition onTypeFormatting)
  string(JSON _available GET "${_lsp}" rows 0 lsp "${_service}" available)
  string(JSON _type TYPE "${_lsp}" rows 0 lsp "${_service}" ms)
  string(JSON _minType TYPE "${_lsp}" rows 0 lsp "${_service}" min_ms)
  string(JSON _maxType TYPE "${_lsp}" rows 0 lsp "${_service}" worst_ms)
  string(JSON _samples GET "${_lsp}" rows 0 lsp "${_service}" samples)
  if(_available OR NOT _type STREQUAL "NULL" OR
     NOT _minType STREQUAL "NULL" OR NOT _maxType STREQUAL "NULL" OR
     NOT _samples EQUAL 0)
    message(FATAL_ERROR "absent LSP service was reported as measured: ${_service}")
  endif()
endforeach()
string(JSON _symbols GET "${_lsp}" rows 0 lsp documentSymbol results)
string(JSON _edits GET "${_lsp}" rows 0 lsp formatting results)
string(JSON _rangeEdits GET "${_lsp}" rows 0 lsp rangeFormatting results)
if(NOT _symbols EQUAL 1 OR NOT _edits EQUAL 1 OR NOT _rangeEdits EQUAL 0 OR
   NOT EXISTS "${WORK}/lsp-lsp.csv")
  message(FATAL_ERROR "LSP replies or companion CSV were not exported")
endif()
run_bench("${SERVICES_BENCH}" "${_input}" --iterations 2
    --json "${WORK}/lsp-repeated.json")
file(READ "${WORK}/lsp-repeated.json" _repeated)
foreach(_service documentSymbol completion semanticTokens/full semanticTokens/range)
  string(JSON _samples GET "${_repeated}" rows 0 lsp "${_service}" samples)
  string(JSON _probes GET "${_repeated}" rows 0 lsp "${_service}" probes)
  string(JSON _min GET "${_repeated}" rows 0 lsp "${_service}" min_ms)
  string(JSON _ms GET "${_repeated}" rows 0 lsp "${_service}" ms)
  string(JSON _max GET "${_repeated}" rows 0 lsp "${_service}" worst_ms)
  math(EXPR _expected "2 * ${_probes}")
  if(NOT _samples EQUAL _expected OR _min LESS 0 OR _ms LESS _min OR
     _max LESS _ms)
    message(FATAL_ERROR "repeated LSP calls were not included: ${_service}")
  endif()
endforeach()
run_bench("${SERVICES_BENCH}" "${_input}" --iterations 1 --no-lsp
    --json "${WORK}/no-lsp.json")
file(READ "${WORK}/no-lsp.json" _disabled)
string(JSON _count LENGTH "${_disabled}" rows 0 lsp)
if(NOT _count EQUAL 0)
  message(FATAL_ERROR "--no-lsp still ran LSP probes")
endif()
file(READ "${WORK}/files.csv" _csv)
if(NOT _csv MATCHES "\"a,\"\"b\\\\c.tiny\"")
  message(FATAL_ERROR "CSV did not quote the input file name: ${_csv}")
endif()

run_bench("${BENCH}" "${_input}" --rss --json "${WORK}/rss.json")
file(READ "${WORK}/rss.json" _rss)
string(JSON _lspCount LENGTH "${_rss}" rows 0 lsp)
string(JSON _iterations GET "${_rss}" rows 0 iterations)
if(NOT _lspCount EQUAL 0 OR NOT _iterations EQUAL 1)
  message(FATAL_ERROR "RSS mode ran the warm parse lane or repeated a build")
endif()
run_bench("${BENCH}" "${_input}" --rss --iterations 4
    --json "${WORK}/rss-order.json")
file(READ "${WORK}/rss-order.json" _rss)
string(JSON _iterations GET "${_rss}" rows 0 iterations)
if(NOT _iterations EQUAL 1)
  message(FATAL_ERROR "RSS mode depended on the option order")
endif()
refuse_bench()
refuse_bench("${WORK}/missing.tiny")
refuse_bench("${_input}" --rss "${_other}")
refuse_bench("${_input}" --multi)
refuse_bench(--dump-corpus "${WORK}/invalid")
refuse_bench(--unknown)

# A consumer-supplied generator uses the existing dump/replay and worker lanes.
run_bench("${GENERATED}" --sizes 64 --no-multi --dump-corpus "${WORK}/corpus")
run_bench("${GENERATED}" --sizes 64 --no-multi --iterations 1
    --corpus "${WORK}/corpus" --json "${WORK}/replay.json")
file(READ "${WORK}/replay.json" _replay)
string(JSON _label GET "${_replay}" rows 0 label)
string(JSON _source GET "${_replay}" rows 0 source)
if(NOT _label STREQUAL "64B" OR NOT _source MATCHES "^disk:")
  message(FATAL_ERROR "generated corpus did not replay: ${_replay}")
endif()
run_bench("${GENERATED}" --multi --multi-bytes 64 --workers 0,1 --iterations 1
    --json "${WORK}/multi.json")
file(READ "${WORK}/multi.json" _multi)
string(JSON _count LENGTH "${_multi}" multi)
string(JSON _points LENGTH "${_multi}" multi 0 points)
if(NOT _count EQUAL 4 OR NOT _points EQUAL 2)
  message(FATAL_ERROR "consumer's multi-document worker curve is incomplete")
endif()
