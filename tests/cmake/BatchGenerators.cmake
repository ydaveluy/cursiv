include_guard(GLOBAL)

# Each executable keeps its name and its own command-line entry point. Four
# lowerings share a compilation of the generator's headers and common code.
function(_cursiv_generator_batch engine index)
  set(_members ${ARGN})
  list(LENGTH _members _count)
  if(_count LESS 2)
    return()
  endif()
  set(_batch cursiv_test_generators_${engine}_${index})
  set(_source "${CMAKE_CURRENT_BINARY_DIR}/CMakeFiles/${_batch}.cpp")
  set(_text "// Generated test grammar generator batch.\n")
  set(_includes "")
  set(_links "")
  foreach(_target IN LISTS _members)
    get_target_property(_definitions ${_target} COMPILE_DEFINITIONS)
    get_target_property(_roots ${_target} INCLUDE_DIRECTORIES)
    get_target_property(_libraries ${_target} LINK_LIBRARIES)
    get_target_property(_main ${_target} SOURCES)
    list(APPEND _includes ${_roots})
    list(APPEND _links ${_libraries})
    string(MAKE_C_IDENTIFIER "cursiv_test_${_target}" _scope)
    string(APPEND _text
        "#define CURSIV_GEN_NO_MAIN\n#define CURSIV_GEN_SCOPE ${_scope}\n")
    foreach(_definition IN LISTS _definitions)
      string(REGEX REPLACE "^([^=]+)=" "\\1 " _define "${_definition}")
      string(APPEND _text "#define ${_define}\n")
      if(_definition MATCHES "^CURSIV_GEN_HEADER=\"(.*)\"$")
        set(_header "${CMAKE_MATCH_1}")
      endif()
    endforeach()
    # Keep the original header spelling in the emitted artifacts. Its include
    # uses an absolute path so bare sibling headers cannot shadow one another.
    set(_resolved "")
    if(IS_ABSOLUTE "${_header}")
      set(_resolved "${_header}")
    else()
      foreach(_root IN LISTS _roots)
        if(EXISTS "${_root}/${_header}")
          set(_resolved "${_root}/${_header}")
          break()
        endif()
      endforeach()
    endif()
    if(NOT _resolved)
      message(FATAL_ERROR "Cannot resolve test generator header ${_header}")
    endif()
    string(APPEND _text
        "#define CURSIV_GEN_INCLUDE \"${_resolved}\"\n"
        "#include \"${_main}\"\n#undef CURSIV_GEN_INCLUDE\n")
    foreach(_definition IN LISTS _definitions)
      string(REGEX REPLACE "=.*$" "" _key "${_definition}")
      string(APPEND _text "#undef ${_key}\n")
    endforeach()
    string(APPEND _text "#undef CURSIV_GEN_SCOPE\n#undef CURSIV_GEN_NO_MAIN\n")

    set(_entry "${CMAKE_CURRENT_BINARY_DIR}/CMakeFiles/${_target}_entry.cpp")
    file(GENERATE OUTPUT "${_entry}" CONTENT
        "namespace ${_scope} { int run(int, char**); }\nint main(int argc, char** argv) { return ${_scope}::run(argc, argv); }\n")
    set_property(TARGET ${_target} PROPERTY SOURCES "${_entry}")
    target_link_libraries(${_target} PRIVATE ${_batch})
  endforeach()
  list(REMOVE_DUPLICATES _includes)
  list(REMOVE_DUPLICATES _links)
  file(GENERATE OUTPUT "${_source}" CONTENT "${_text}")
  add_library(${_batch} OBJECT EXCLUDE_FROM_ALL "${_source}")
  target_include_directories(${_batch} PRIVATE ${_includes})
  target_link_libraries(${_batch} PRIVATE ${_links})
  list(GET _members 0 _first)
  get_target_property(_options ${_first} COMPILE_OPTIONS)
  target_compile_options(${_batch} PRIVATE ${_options})
  foreach(_property IN ITEMS CXX_STANDARD CXX_STANDARD_REQUIRED CXX_EXTENSIONS)
    get_target_property(_value ${_first} ${_property})
    if(NOT _value MATCHES "-NOTFOUND$")
      set_property(TARGET ${_batch} PROPERTY ${_property} "${_value}")
    endif()
  endforeach()
endfunction()

function(cursiv_batch_test_generators)
  get_property(_targets GLOBAL PROPERTY CURSIV_TEST_GENERATORS)
  foreach(_engine IN ITEMS ll lr)
    set(_members "")
    set(_index 0)
    set(_ordinary_options "")
    foreach(_target IN LISTS _targets)
      get_target_property(_main ${_target} SOURCES)
      if(NOT _main MATCHES "/${_engine}_main[.]cpp$")
        continue()
      endif()
      get_target_property(_definitions ${_target} COMPILE_DEFINITIONS)
      get_target_property(_options ${_target} COMPILE_OPTIONS)
      # Shallow-template fixtures check a compiler configuration of their own.
      if(_options MATCHES "ftemplate-depth")
        continue()
      endif()
      set(_ordinary TRUE)
      foreach(_definition IN LISTS _definitions)
        if(NOT _definition MATCHES "^CURSIV_GEN_[A-Z_]+=")
          set(_ordinary FALSE)
        endif()
      endforeach()
      if(NOT _ordinary)
        continue()
      endif()
      set(_signature "${_options}")
      foreach(_property IN ITEMS CXX_STANDARD CXX_STANDARD_REQUIRED CXX_EXTENSIONS)
        get_target_property(_value ${_target} ${_property})
        string(APPEND _signature "|${_property}=${_value}")
      endforeach()
      if(_ordinary_options STREQUAL "")
        set(_ordinary_options "${_signature}")
      elseif(NOT _ordinary_options STREQUAL _signature)
        continue()
      endif()
      list(APPEND _members ${_target})
      list(LENGTH _members _count)
      if(_count EQUAL 4)
        _cursiv_generator_batch(${_engine} ${_index} ${_members})
        math(EXPR _index "${_index} + 1")
        set(_members "")
      endif()
    endforeach()
    _cursiv_generator_batch(${_engine} ${_index} ${_members})
  endforeach()
endfunction()
