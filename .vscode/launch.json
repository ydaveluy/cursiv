{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run Statemachine Extension",
      "type": "extensionHost",
      "request": "launch",
      "runtimeExecutable": "${execPath}",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}/examples/statemachine/vscode",
        "${workspaceFolder}/examples/statemachine/example"
      ],
      "outFiles": [
        "${workspaceFolder}/examples/statemachine/vscode/out/**/*.js"
      ],
      "env": {
        "CURSIV_SERVER_DIR": "${command:cmake.buildDirectory}/examples/statemachine/src"
      },
      "preLaunchTask": "Prepare Statemachine Extension"
    },
    {
      "name": "Run Domainmodel Extension",
      "type": "extensionHost",
      "request": "launch",
      "runtimeExecutable": "${execPath}",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}/examples/domainmodel/vscode",
        "${workspaceFolder}/examples/domainmodel/example"
      ],
      "outFiles": [
        "${workspaceFolder}/examples/domainmodel/vscode/out/**/*.js"
      ],
      "env": {
        "CURSIV_SERVER_DIR": "${command:cmake.buildDirectory}/examples/domainmodel/src"
      },
      "preLaunchTask": "Prepare Domainmodel Extension"
    },
    {
      "name": "Run Requirements and Tests Extension",
      "type": "extensionHost",
      "request": "launch",
      "runtimeExecutable": "${execPath}",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}/examples/requirements/vscode",
        "${workspaceFolder}/examples/requirements/example"
      ],
      "outFiles": [
        "${workspaceFolder}/examples/requirements/vscode/out/**/*.js"
      ],
      "env": {
        "CURSIV_SERVER_DIR": "${command:cmake.buildDirectory}/examples/requirements/src"
      },
      "preLaunchTask": "Prepare Requirements and Tests Extension"
    },
    {
      "name": "Run Arithmetics Extension",
      "type": "extensionHost",
      "request": "launch",
      "runtimeExecutable": "${execPath}",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}/examples/arithmetics/vscode",
        "${workspaceFolder}/examples/arithmetics/example"
      ],
      "outFiles": [
        "${workspaceFolder}/examples/arithmetics/vscode/out/**/*.js"
      ],
      "env": {
        "CURSIV_SERVER_DIR": "${command:cmake.buildDirectory}/examples/arithmetics/src"
      },
      "preLaunchTask": "Prepare Arithmetics Extension"
    }
  ]
}
