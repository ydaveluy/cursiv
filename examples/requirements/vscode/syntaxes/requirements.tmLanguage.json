{
  "name": "requirements-lang",
  "scopeName": "source.requirements-lang",
  "fileTypes": [
    "req"
  ],
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#keywords"
    },
    {
      "name": "string.quoted.double.requirements-lang",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        {
          "name": "constant.character.escape.requirements-lang",
          "match": "\\\\."
        }
      ]
    },
    {
      "name": "string.quoted.single.requirements-lang",
      "begin": "'",
      "end": "'",
      "patterns": [
        {
          "name": "constant.character.escape.requirements-lang",
          "match": "\\\\."
        }
      ]
    }
  ],
  "repository": {
    "keywords": {
      "name": "keyword.control.requirements-lang",
      "match": "(?<![0-9A-Z_a-z])([eE][nN][vV][iI][rR][oO][nN][mM][eE][nN][tT]|[aA][pP][pP][lL][iI][cC][aA][bB][lL][eE]|[cC][oO][nN][tT][aA][cC][tT]|[fF][oO][rR]|[rR][eE][qQ])(?![0-9A-Z_a-z])"
    },
    "comments": {
      "patterns": [
        {
          "name": "comment.block.requirements-lang",
          "begin": "/\\*",
          "end": "\\*/"
        },
        {
          "name": "comment.line.requirements-lang",
          "begin": "//",
          "end": "(?=$)"
        }
      ]
    }
  }
}
