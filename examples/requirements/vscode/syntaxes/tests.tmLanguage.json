{
  "name": "tests-lang",
  "scopeName": "source.tests-lang",
  "fileTypes": [
    "tst"
  ],
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#keywords"
    },
    {
      "name": "string.quoted.double.tests-lang",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        {
          "name": "constant.character.escape.tests-lang",
          "match": "\\\\."
        }
      ]
    },
    {
      "name": "string.quoted.single.tests-lang",
      "begin": "'",
      "end": "'",
      "patterns": [
        {
          "name": "constant.character.escape.tests-lang",
          "match": "\\\\."
        }
      ]
    }
  ],
  "repository": {
    "keywords": {
      "name": "keyword.control.tests-lang",
      "match": "(?<![0-9A-Z_a-z])([aA][pP][pP][lL][iI][cC][aA][bB][lL][eE]|[tT][eE][sS][tT][fF][iI][lL][eE]|[cC][oO][nN][tT][aA][cC][tT]|[tT][eE][sS][tT][sS]|[fF][oO][rR]|[tT][sS][tT])(?![0-9A-Z_a-z])"
    },
    "comments": {
      "patterns": [
        {
          "name": "comment.block.tests-lang",
          "begin": "/\\*",
          "end": "\\*/"
        },
        {
          "name": "comment.line.tests-lang",
          "begin": "//",
          "end": "(?=$)"
        }
      ]
    }
  }
}
