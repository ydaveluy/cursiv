{
  "name": "cursiv-requirements",
  "displayName": "cursiv Requirements and Tests",
  "description": "Two DSLs on one server: requirements and the tests that cover them",
  "version": "0.1.0",
  "publisher": "cursiv",
  "private": true,
  "license": "MIT",
  "engines": {
    "vscode": "^1.86.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "activationEvents": [
    "onLanguage:requirements-lang",
    "onLanguage:tests-lang"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "requirements-lang",
        "aliases": [
          "Requirements Language",
          "requirements-lang"
        ],
        "extensions": [
          ".req"
        ],
        "configuration": "./language-configuration.json"
      },
      {
        "id": "tests-lang",
        "aliases": [
          "Tests Language",
          "tests-lang"
        ],
        "extensions": [
          ".tst"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "requirements-lang",
        "scopeName": "source.requirements-lang",
        "path": "./syntaxes/requirements.tmLanguage.json"
      },
      {
        "language": "tests-lang",
        "scopeName": "source.tests-lang",
        "path": "./syntaxes/tests.tmLanguage.json"
      }
    ],
    "configurationDefaults": {
      "[requirements-lang]": {
        "editor.suggest.insertMode": "replace"
      },
      "[tests-lang]": {
        "editor.suggest.insertMode": "replace"
      }
    },
    "configuration": {
      "title": "cursiv Requirements and Tests",
      "properties": {
        "cursiv.requirements.serverPath": {
          "type": "string",
          "default": "",
          "description": "Absolute path to the requirements_lsp executable. Empty means the default build tree, build/examples/requirements/."
        }
      }
    },
    "mcpServerDefinitionProviders": [
      {
        "id": "cursiv.requirements.mcp",
        "label": "cursiv Requirements and Tests"
      }
    ]
  },
  "scripts": {
    "compile": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "bundle": "node esbuild.mjs --production",
    "typecheck": "tsc -p tsconfig.json",
    "vscode:prepublish": "npm run bundle",
    "package": "vsce package --no-dependencies --allow-missing-repository"
  },
  "files": [
    "package.json",
    "out",
    "server",
    "language-configuration.json",
    "syntaxes"
  ],
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "@types/vscode": "~1.86.0",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2",
    "@vscode/vsce": "^3.9.2"
  },
  "vsce": {
    "dependencies": false
  },
  "overrides": {
    "@vscode/vsce": {
      "@azure/identity": "4.13.0"
    },
    "@azure/msal-node": {
      "uuid": "^11.1.1"
    }
  }
}
