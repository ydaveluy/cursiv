// The requirements side of the example: what the product must do, and where.
contact: "Mickey Mouse"

environment Windows10: "our standard PC"
environment Linux_x86: "for CI"

req ReqId000 "The generator shall extract all test cases referencing a requirement"
req ReqId001_tstID "A test identifier shall contain a number." applicable for Windows10, Linux_x86
req ReqId002_reqID "A requirement identifier shall contain a number." applicable for Windows10
req ReqId003_reqCov "A requirement shall be covered by at least one test"
