{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Prepare Requirements and Tests Extension",
      "detail": "Build requirements_lsp in the active preset's tree, then bundle the client.",
      "type": "shell",
      "command": "${workspaceFolder}/../../tools/prepare.sh",
      "args": [
        "requirements"
      ],
      "options": {
        "cwd": "${workspaceFolder}/../..",
        "env": {
          "CURSIV_BUILD_DIR": "${command:cmake.buildDirectory}"
        }
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": [
        "$gcc"
      ],
      "presentation": {
        "reveal": "silent",
        "panel": "shared",
        "clear": true
      }
    }
  ]
}
