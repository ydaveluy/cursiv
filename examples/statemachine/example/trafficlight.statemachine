// The traffic light, the canonical statemachine document.
statemachine TrafficLight

events
    switchCapacity
    next

commands
    flashAmber

initialState PowerOff

state PowerOff
    switchCapacity => RedLight
end

state RedLight
    switchCapacity => PowerOff
    next => GreenLight
end

state YellowLight
    actions { flashAmber }
    switchCapacity => PowerOff
    next => RedLight
end

state GreenLight
    switchCapacity => PowerOff
    next => YellowLight
end
