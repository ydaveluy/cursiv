// head_fault: the 'statemachine' keyword at byte 0 is misspelt
// break: 000081
statmachine TrafficLight

events
    switchCapacity
    next

commands
    flashRed
    flashGreen

initialState PowerOff

state PowerOff
    switchCapacity => RedLight
end

state RedLight
    actions { flashRed }
    switchCapacity => PowerOff
    next => GreenLight
end

state YellowLight
    switchCapacity => PowerOff
    next => RedLight
end

state GreenLight
    actions { flashGreen }
    switchCapacity => PowerOff
    next => YellowLight
end
