{
  "name": "statemachine",
  "scopeName": "source.statemachine",
  "fileTypes": [
    "statemachine"
  ],
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#keywords"
    }
  ],
  "repository": {
    "keywords": {
      "name": "keyword.control.statemachine",
      "match": "(?i)\\b(initialState|statemachine|commands|actions|events|state|end)\\b"
    },
    "comments": {
      "patterns": [
        {
          "name": "comment.block.statemachine",
          "begin": "/\\*",
          "end": "\\*/"
        },
        {
          "name": "comment.line.statemachine",
          "begin": "//",
          "end": "(?=$)"
        }
      ]
    }
  }
}
