{
  "name": "statemachine",
  "scopeName": "source.statemachine",
  "fileTypes": [
    "statemachine"
  ],
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#keywords"
    }
  ],
  "repository": {
    "keywords": {
      "name": "keyword.control.statemachine",
      "match": "(?<![0-9A-Z_a-z])([iI][nN][iI][tT][iI][aA][lL][Ss][tT][aA][tT][eE]|[sS][tT][aA][tT][eE][mM][aA][cC][hH][iI][nN][eE]|[cC][oO][mM][mM][aA][nN][dD][sS]|[aA][cC][tT][iI][oO][nN][sS]|[eE][vV][eE][nN][tT][sS]|[sS][tT][aA][tT][eE]|[eE][nN][dD])(?![0-9A-Z_a-z])"
    },
    "comments": {
      "patterns": [
        {
          "name": "comment.block.statemachine",
          "begin": "/\\*",
          "end": "\\*/"
        },
        {
          "name": "comment.line.statemachine",
          "begin": "//",
          "end": "(?=$)"
        }
      ]
    }
  }
}
