{
  "name": "arithmetics",
  "scopeName": "source.arithmetics",
  "fileTypes": [
    "calc"
  ],
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#keywords"
    },
    {
      "name": "constant.numeric.arithmetics",
      "match": "\\b\\d+(\\.\\d*)?"
    }
  ],
  "repository": {
    "keywords": {
      "name": "keyword.control.arithmetics",
      "match": "(?i)\\b(module|def)\\b"
    },
    "comments": {
      "patterns": [
        {
          "name": "comment.block.arithmetics",
          "begin": "/\\*",
          "end": "\\*/"
        },
        {
          "name": "comment.line.arithmetics",
          "begin": "//",
          "end": "(?=$)"
        }
      ]
    }
  }
}
