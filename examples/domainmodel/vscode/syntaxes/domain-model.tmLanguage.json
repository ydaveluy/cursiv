{
  "name": "domain-model",
  "scopeName": "source.domain-model",
  "fileTypes": [
    "dmodel"
  ],
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "name": "keyword.control.domain-model",
      "match": "(?i)\\b(datatype|entity|extends|many|package)\\b"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.block.domain-model",
          "begin": "/\\*",
          "end": "\\*/"
        },
        {
          "name": "comment.line.domain-model",
          "begin": "//",
          "end": "(?=$)"
        }
      ]
    }
  }
}
