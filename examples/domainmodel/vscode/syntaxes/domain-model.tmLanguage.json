{
  "name": "domain-model",
  "scopeName": "source.domain-model",
  "fileTypes": [
    "dmodel"
  ],
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#keywords"
    }
  ],
  "repository": {
    "keywords": {
      "name": "keyword.control.domain-model",
      "match": "(?<![0-9A-Z_a-z])([dD][aA][tT][aA][tT][yY][pP][eE]|[eE][xX][tT][eE][nN][dD][sS]|[pP][aA][cC][kK][aA][gG][eE]|[eE][nN][tT][iI][tT][yY]|[mM][aA][nN][yY])(?![0-9A-Z_a-z])"
    },
    "comments": {
      "patterns": [
        {
          "name": "comment.block.domain-model",
          "begin": "/\\*",
          "end": "\\*/"
        },
        {
          "name": "comment.line.domain-model",
          "begin": "//",
          "end": "(?=$)"
        }
      ]
    }
  }
}
