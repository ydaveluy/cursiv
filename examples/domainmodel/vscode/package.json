{
  "name": "cursiv-domainmodel",
  "displayName": "cursiv Domainmodel",
  "description": "Domain model DSL, parsed by cursiv",
  "version": "0.1.0",
  "publisher": "cursiv",
  "private": true,
  "license": "MIT",
  "engines": {
    "vscode": "^1.86.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "activationEvents": [
    "onLanguage:domainmodel"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "domain-model",
        "aliases": [
          "DomainModel",
          "domain-model"
        ],
        "extensions": [
          ".dmodel"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "domain-model",
        "scopeName": "source.domain-model",
        "path": "./syntaxes/domain-model.tmLanguage.json"
      }
    ],
    "configurationDefaults": {
      "[domain-model]": {
        "editor.suggest.insertMode": "replace"
      }
    },
    "configuration": {
      "title": "cursiv Domainmodel",
      "properties": {
        "cursiv.domainmodel.serverPath": {
          "type": "string",
          "default": "",
          "description": "Absolute path to the domainmodel_lsp executable. Empty means the default build tree, build/examples/domainmodel/."
        }
      }
    },
    "mcpServerDefinitionProviders": [
      {
        "id": "cursiv.domainmodel.mcp",
        "label": "cursiv Domainmodel"
      }
    ]
  },
  "scripts": {
    "compile": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "bundle": "node esbuild.mjs --production",
    "typecheck": "tsc -p tsconfig.json",
    "vscode:prepublish": "npm run bundle",
    "package": "vsce package --no-dependencies --allow-missing-repository"
  },
  "files": [
    "package.json",
    "out",
    "server",
    "language-configuration.json",
    "syntaxes"
  ],
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "@types/vscode": "~1.86.0",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2",
    "@vscode/vsce": "^3.9.2"
  },
  "vsce": {
    "dependencies": false
  },
  "overrides": {
    "@vscode/vsce": {
      "@azure/identity": "4.13.0"
    },
    "@azure/msal-node": {
      "uuid": "^11.1.1"
    }
  }
}
