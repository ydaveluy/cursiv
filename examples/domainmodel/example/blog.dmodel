// A blog: datatypes, entities, inheritance and a nested package.
datatype String
datatype Date

entity HasAuthor {
    author: String
}

entity Post extends HasAuthor {
    title: String
    published: Date
    many comments: Comment
}

entity Comment extends HasAuthor {
    content: String
}

package archive {
    /* A qualified name reaches out of the package it is written in. */
    entity Snapshot {
        taken: Date
        many posts: Post
    }
}
