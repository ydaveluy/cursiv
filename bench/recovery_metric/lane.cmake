# The recovery metric held to its classes: per grammar and class, faults
# found, parasites, diagnostics and AST nodes kept may not move past one
# document's worth from `lane.tsv`. `-DWRITE=1` writes the file from this run.
execute_process(
    COMMAND ${EMULATOR} ${METRIC} --docs 32 --no-cost --json ${OUT}.json
    OUTPUT_VARIABLE text
    RESULT_VARIABLE code)
if(NOT code EQUAL 0)
  message(FATAL_ERROR "recovery_metric answered ${code}\n${text}")
endif()
file(READ ${OUT}.json json)
set(rows "")
string(JSON ng LENGTH "${json}" grammars)
math(EXPR lastG "${ng} - 1")
foreach(g RANGE ${lastG})
  string(JSON name GET "${json}" grammars ${g} name)
  string(JSON nc LENGTH "${json}" grammars ${g} classes)
  math(EXPR lastC "${nc} - 1")
  foreach(c RANGE ${lastC})
    set(row "${name}")
    foreach(path "class" "docs" "faults" "found" "parasites" "diagnostics"
            "ast;kept" "ast;total")
      string(JSON v GET "${json}" grammars ${g} classes ${c} ${path})
      string(APPEND row "\t${v}")
    endforeach()
    list(APPEND rows "${row}")
  endforeach()
endforeach()

if(WRITE)
  list(JOIN rows "\n" out)
  file(WRITE ${TSV} "${out}\n")
  message(STATUS "wrote ${TSV}")
  return()
endif()

file(STRINGS ${TSV} want)
list(LENGTH want nw)
list(LENGTH rows nr)
if(NOT nw EQUAL nr)
  message(FATAL_ERROR "${nr} classes against ${nw} in ${TSV}: write it again")
endif()
set(failed "")
foreach(i RANGE 1 ${nr})
  math(EXPR k "${i} - 1")
  list(GET rows ${k} got)
  list(GET want ${k} ref)
  string(REPLACE "\t" ";" got "${got}")
  string(REPLACE "\t" ";" ref "${ref}")
  list(GET ref 0 grammar)
  list(GET ref 1 cls)
  foreach(n RANGE 0 8)
    list(GET got ${n} g${n})
    list(GET ref ${n} r${n})
  endforeach()
  if(NOT g0 STREQUAL r0 OR NOT g1 STREQUAL r1 OR NOT g2 EQUAL r2 OR
     NOT g3 EQUAL r3)
    message(FATAL_ERROR "${grammar} ${cls}: the corpus moved, write it again")
  endif()
  if(r2 EQUAL 0)
    continue()
  endif()
  # One document's worth: its faults, and its share of the twin's nodes.
  math(EXPR slack "(${r3} + ${r2} - 1) / ${r2}")
  math(EXPR nodes "(${r8} + ${r2} - 1) / ${r2}")
  math(EXPR found "${r4} - ${slack}")
  math(EXPR parasites "${r5} + ${slack}")
  math(EXPR diagnostics "${r6} + ${slack}")
  math(EXPR kept "${r7} - ${nodes}")
  if(g4 LESS found)
    list(APPEND failed "${grammar} ${cls}: found ${g4}, held at ${r4}")
  endif()
  if(g5 GREATER parasites)
    list(APPEND failed "${grammar} ${cls}: parasites ${g5}, held at ${r5}")
  endif()
  if(g6 GREATER diagnostics)
    list(APPEND failed "${grammar} ${cls}: diagnostics ${g6}, held at ${r6}")
  endif()
  if(g7 LESS kept)
    list(APPEND failed "${grammar} ${cls}: AST kept ${g7}, held at ${r7}")
  endif()
endforeach()
if(failed)
  list(JOIN failed "\n" out)
  message(FATAL_ERROR "the repairs moved past their classes' hold:\n${out}")
endif()
message(STATUS "recovery metric within its hold: ${nr} classes")
