-static void* mi_prim_mem_grow(size_t size, size_t try_alignment) {
+// The free part of the module's initial memory, from the linker: used before
+// growing the memory, as wasi-libc's malloc does.
+extern unsigned char __heap_base;
+extern unsigned char __heap_end;
+static uintptr_t mi_initial_next;
+
+static void* mi_initial_take(size_t size, size_t try_alignment) {
+  const size_t alignment = (try_alignment > _mi_os_page_size() ? try_alignment : _mi_os_page_size());
+  const uintptr_t end = (uintptr_t)&__heap_end;
   void* p = NULL;
+  #if MI_USE_PTHREADS
+  pthread_mutex_lock(&mi_theap_grow_mutex);
+  #endif
+  if (mi_initial_next == 0) { mi_initial_next = (uintptr_t)&__heap_base; }
+  const uintptr_t start = mi_align_up(mi_initial_next, alignment);
+  if (start <= end && size <= end - start) {
+    mi_initial_next = start + size;
+    p = (void*)start;
+  }
+  #if MI_USE_PTHREADS
+  pthread_mutex_unlock(&mi_theap_grow_mutex);
+  #endif
+  return p;
+}
+
+static void* mi_prim_mem_grow(size_t size, size_t try_alignment) {
+  void* p = mi_initial_take(size, try_alignment);
+  if (p != NULL) return p;
   if (try_alignment <= 1) {
     // `sbrk` is not thread safe in general so try to protect it (we could skip this on WASM but leave it in for now)
     #if MI_USE_PTHREADS
@@ -304,6 +330,43 @@ bool _mi_prim_random_buf(void* buf, size_t buf_len) {
 // Thread init/done
 //----------------------------------------------------------------
 
+#if MI_USE_PTHREADS
+
+// use pthread local storage keys to detect thread ending
+// (and used with MI_TLS_PTHREADS for the default theap)
+// atomic as a thread may initialize while the process is exiting and deleting the key
+static _Atomic(pthread_key_t) _mi_heap_default_key = MI_ATOMIC_VAR_INIT(MI_PTHREAD_KEY_INVALID);
+
+static void mi_pthread_done(void* value) {
+  if (value!=NULL) {
+    _mi_thread_done((mi_theap_t*)value);
+  }
+}
+
+void _mi_prim_thread_init_auto_done(void) {
+  mi_assert_internal(mi_atomic_load_relaxed(&_mi_heap_default_key) == MI_PTHREAD_KEY_INVALID);
+  pthread_key_t key;
+  if (pthread_key_create(&key, &mi_pthread_done) == 0) {
+    mi_atomic_store_release(&_mi_heap_default_key, key);
+  }
+}
+
+void _mi_prim_thread_done_auto_done(void) {
+  pthread_key_t key = mi_atomic_exchange_relaxed(&_mi_heap_default_key, MI_PTHREAD_KEY_INVALID);
+  if (key != MI_PTHREAD_KEY_INVALID) {  // do not leak the key, see issue #809
+    pthread_key_delete(key);
+  }
+}
+
+void _mi_prim_thread_associate_default_theap(mi_theap_t* theap) {
+  pthread_key_t key = mi_atomic_load_relaxed(&_mi_heap_default_key);
+  if (key != MI_PTHREAD_KEY_INVALID) {  // can happen during recursive invocation on freeBSD
+    pthread_setspecific(key, theap);
+  }
+}
+
+#else
+
 void _mi_prim_thread_init_auto_done(void) {
   // nothing
 }
